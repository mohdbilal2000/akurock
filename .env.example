# --- Booking / quotation notifications (lib/notify.ts) ---

# Email via Resend (https://resend.com — free tier). Without this key,
# booking emails are skipped (logged as a warning).
RESEND_API_KEY=

# WhatsApp via CallMeBot. One-time setup: from the target WhatsApp number,
# send "I allow callmebot to send me messages" to +34 644 51 95 23 and the
# bot replies with your apikey. Without it, WhatsApp notifications are skipped.
CALLMEBOT_APIKEY=

# Optional overrides (defaults shown)
# QUOTATION_EMAIL_TO=mb9400900@gmail.com
# QUOTATION_EMAIL_FROM=AKUROCK Website <onboarding@resend.dev>
# WHATSAPP_NOTIFY_NUMBER=+919057597719

# --- Admin panel ---
# Protects /admin and /api/admin/* via HTTP Basic Auth
ADMIN_PASSWORD=

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
